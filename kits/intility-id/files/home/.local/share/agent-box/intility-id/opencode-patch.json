{
  "permission": {
    "intility-id_*": "ask",
    "intility-id_id_get_*": "allow",
    "intility-id_id_list_*": "allow",
    "intility-id_id_check_*": "allow",
    "intility-id_id_batch_check": "allow",
    "intility-id_id_describe_*": "allow",
    "intility-id_id_preview_delete": "allow"
  },
  "mcp": {
    "intility-id": {
      "type": "remote",
      "url": "http://mcp-gateway.docker.internal/mcp",
      "headers": {
        "Authorization": "Bearer proxy-managed"
      },
      "oauth": false,
      "enabled": true
    }
  }
}
